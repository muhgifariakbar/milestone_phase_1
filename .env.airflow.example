# Airflow metadata database (its own Postgres, separate from the
# retail_analytics target defined in docker-compose.yml).
POSTGRES_USER=airflow
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=airflow

# Airflow runtime
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=replace-with-a-fernet-key
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:replace-with-a-local-password@airflow-postgres/airflow
AIRFLOW__DATABASE__LOAD_DEFAULT_CONNECTIONS=False

# Airflow initialization
_AIRFLOW_DB_UPGRADE=True
_AIRFLOW_WWW_USER_CREATE=True
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=replace-with-airflow-ui-password

# Pipeline target: the retail_analytics PostgreSQL from docker-compose.yml,
# reached from inside the Airflow containers via the Docker host gateway
# (see the extra_hosts entry in airflow.yaml). Run `docker compose up -d
# postgres` from the main compose file first. LOCAL_POSTGRES_PORT must
# match whatever host port that compose file actually publishes (the left
# side of its "ports:" mapping for the postgres service) -- not
# necessarily 5432, if that port was already taken on your machine.
ANALYTICS_DB_TARGET=local
LOCAL_POSTGRES_HOST=host.docker.internal
LOCAL_POSTGRES_PORT=5432
LOCAL_POSTGRES_DB=retail_analytics
LOCAL_POSTGRES_USER=retail
LOCAL_POSTGRES_PASSWORD=retail
